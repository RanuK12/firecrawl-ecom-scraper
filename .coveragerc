[run]
source = .
omit =
    */test_*.py
    */tests/*
    */__pycache__/*
    */venv/*
    */.venv/*
    */env/*
    */build/*
    */dist/*
    */docs/*
    */fixtures/*
    */migrations/*

[report]
omit =
    */test_*.py
    */tests/*
    */__pycache__/*
    */venv/*
    */.venv/*
    */env/*
    */build/*
    */dist/*
    */docs/*
    */fixtures/*
    */migrations/*
