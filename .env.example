# Firecrawl E-commerce Scraper - Environment Variables
# Copy this file to .env and fill in your values

# Required: Firecrawl API key (get yours at https://firecrawl.dev)
FIRECRAWL_API_KEY=your_api_key_here

# Optional: Default target URL to scrape
TARGET_URL=https://example.com

# Optional: Default output CSV file
OUTPUT_CSV=output.csv