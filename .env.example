# Firecrawl E-commerce Scraper - Environment Variables
# Copy this file to .env and fill in your values

# Required: Firecrawl API key (get yours at https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your_api_key_here

# Optional: Default output format (csv or json)
# OUTPUT_FORMAT=csv

# Optional: Default output directory
# OUTPUT_DIR=./output